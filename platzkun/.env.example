# このファイルをコピーして「.env」という名前にし、APIキーを書き込んでください。
# .env は GitHub にアップロードされません（.gitignore で除外しています）。

# お試しモード：true にすると Claude を使わず、用意した返事を返す（料金なし）
# APIキーが書かれていないときも、自動でお試しモードになります
DEMO_MODE=false

# Claude の APIキー（https://console.anthropic.com で発行）
ANTHROPIC_API_KEY=sk-ant-ここにキーを貼り付け

# 使うモデル（ふつうは変更不要）
CLAUDE_MODEL=claude-opus-5-5

# 考える深さ：low（速い・安い） / medium（標準） / high（難問向け・遅め）
CLAUDE_EFFORT=medium

# サーバーのポート番号
PORT=3000

# なめらかな声（VOICEVOX）：塾のパソコンで VOICEVOX を起動しておくと、その声で読み上げます
# 起動していなければ、ブラウザ標準の声になります
VOICEVOX_URL=http://127.0.0.1:50021
# 声の種類（番号）：3 = ずんだもん、2 = 四国めたん、8 = 春日部つむぎ、13 = 青山龍星 など
VOICEVOX_SPEAKER=3
# 話す速さ（1.0 が標準）
VOICEVOX_SPEED=1.1
