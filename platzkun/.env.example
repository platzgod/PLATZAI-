# このファイルをコピーして「.env」という名前にし、APIキーを書き込んでください。
# .env は GitHub にアップロードされません（.gitignore で除外しています）。

# お試しモード：true にすると Claude を使わず、用意した返事を返す（料金なし）
# APIキーが書かれていないときも、自動でお試しモードになります
DEMO_MODE=false

# Claude の APIキー（https://console.anthropic.com で発行）
ANTHROPIC_API_KEY=sk-ant-ここにキーを貼り付け

# 使うモデル（ふつうは変更不要）
CLAUDE_MODEL=claude-opus-5-5

# 考える深さ：low（速い・安い） / medium（標準） / high（難問向け・遅め）
CLAUDE_EFFORT=medium

# サーバーのポート番号
PORT=3000
